<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lba" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lba_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Lba.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lba_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_image</item>
        <item name="postSplashScreenTheme">@style/Theme.Lba</item>
    </style>
    <color name="lba_bg">#FDFAFF</color>
    <color name="ic_launcher_background">#FFFFFF</color>
</resources>
